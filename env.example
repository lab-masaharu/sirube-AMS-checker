# ===== sirube-ams-checker / 環境変数テンプレート =====
# このファイルをコピーして「.env」を作り、各値を埋めてください。
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env は絶対にGitに上げないこと（.gitignoreで除外済み）

# --- AMS（agent-master.jp）ログイン情報 ---
AMS_LOGIN_URL=https://agent-master.jp/
AMS_EMAIL=
AMS_PASSWORD=

# --- ふれんずBtoB（今回の巡回では未使用・後のフェーズで使用） ---
FREINS_EMAIL=
FREINS_PASSWORD=

# --- 動作設定 ---
# HEADLESS=false にするとブラウザ画面が見える（初回は false 推奨）
HEADLESS=false
# 1ページ取得ごとの待機ミリ秒（サーバー負荷を抑える・礼儀）
PAGE_WAIT_MS=1500
# 取得する最大ページ数（テスト時は 2 などに絞ると速い。本番は 30 程度）
MAX_PAGES=30

# --- PostgreSQL（Dockerで起動するDB）---
# docker-compose.yml と合わせる。値を変えるなら両方合わせること。
DB_USER=sirube
DB_PASSWORD=sirube_local_pw
DB_NAME=sirube_ams
DB_HOST=localhost
DB_PORT=5544
